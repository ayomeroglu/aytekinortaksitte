{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "image-slot.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Great Vibes|Outfit))/i]",
        "message": "Font not provided by the design system. Available: Great Vibes, Outfit."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--font-sans",
      "--font-script",
      "--m-bg",
      "--m-divider",
      "--m-light",
      "--m-mid",
      "--m-navy",
      "--m-navy-display",
      "--m-silver",
      "--m-soft"
    ],
    "tokenKinds": {
      "--m-bg": "color",
      "--m-soft": "color",
      "--m-divider": "color",
      "--m-silver": "color",
      "--m-mid": "color",
      "--m-navy": "color",
      "--m-navy-display": "color",
      "--m-light": "color",
      "--font-script": "font",
      "--font-sans": "font"
    },
    "fontFamilies": [
      "Great Vibes",
      "Outfit"
    ]
  }
}